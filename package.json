{
  "name": "sportmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prototype": "node scripts/serve-prototype.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:legacy": "node Prototyp/test.js",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
